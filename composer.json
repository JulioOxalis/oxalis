{
    "name": "julio/oxalis",
    "description": "A configurable Laravel Fortify and passkey integration layer",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "laravel/fortify": "^1.40",
        "laravel/passkeys": "^0.2.1"
    },
    "autoload": {
        "psr-4": {
            "Oxalis\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Oxalis\\OxalisServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
